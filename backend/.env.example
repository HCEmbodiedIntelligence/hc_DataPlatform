HC_ENVIRONMENT=local
HC_RUNTIME_BACKEND=production
HC_API_HOST=0.0.0.0
HC_API_PORT=8000
HC_POSTGRES_DSN=postgresql+asyncpg://hc:hc@postgres:5432/hc_data
HC_TEMPORAL_TARGET=temporal:7233
HC_TEMPORAL_TASK_QUEUE=hc-data-pipeline
# Server-only endpoint used by API/Worker/Lance/health and all object reads/writes.
HC_OBJECT_STORE_ENDPOINT=http://minio:9000
# Browser-reachable endpoint used only to create SigV4 multipart-part PUT URLs.
HC_OBJECT_STORE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
HC_OBJECT_STORE_BUCKET=hc-data-local
HC_OBJECT_STORE_ACCESS_KEY=minio
HC_OBJECT_STORE_SECRET_KEY=minio-local-only
HC_OBJECT_STORE_REGION=us-east-1
HC_ARTIFACT_PREFIX=artifacts
# Leave endpoint/models empty to expose an explicit provider-unavailable state.
# In staging/production the endpoint must use HTTPS.
HC_AUTO_ANNOTATION_PROVIDER_NAME=vlm
HC_AUTO_ANNOTATION_PROVIDER_ENDPOINT=
HC_AUTO_ANNOTATION_PROVIDER_MODELS=[]
HC_AUTO_ANNOTATION_PROVIDER_API_KEY=
HC_AUTO_ANNOTATION_PROVIDER_TIMEOUT_SECONDS=60
HC_AUTO_ANNOTATION_MAX_CONCURRENT_JOBS=4
HC_AUTO_ANNOTATION_MAX_JOBS_PER_HOUR=60
HC_AUTO_ANNOTATION_DAILY_COST_LIMIT_MICROS=5000000
# Browser/CLI direct multipart PUT authorization. Set up to 3600 for the
# large-part slow-link policy; each URL is still least-privilege and scoped to one part.
HC_INGEST_PART_AUTHORIZATION_TTL_SECONDS=900
HC_JWT_ISSUER=https://identity.example.invalid/
HC_JWT_AUDIENCE=hc-data-platform
HC_JWT_ALGORITHMS=["HS256"]
HC_JWT_JWKS_URL=
HC_JWT_SIGNING_KEY=local-development-signing-key-change-me
HC_CURSOR_SECRET=local-cursor-secret-change-me
HC_DATA_SOURCE_CREDENTIAL_KEY=local-data-source-credential-key-change-me
HC_PASSWORD_MIN_LENGTH=6
HC_PASSWORD_MAX_LENGTH=128
HC_PASSWORD_SCRYPT_N=32768
HC_PASSWORD_SCRYPT_R=8
HC_PASSWORD_SCRYPT_P=1
HC_SESSION_IDLE_TTL_SECONDS=1800
HC_SESSION_ABSOLUTE_TTL_SECONDS=86400
HC_SESSION_TOUCH_INTERVAL_SECONDS=60
HC_MAX_ACTIVE_SESSIONS=5
HC_AUTH_ABUSE_ENABLED=false
# Required when HC_AUTH_ABUSE_ENABLED=true (at least 32 secret characters).
HC_AUTH_ABUSE_HMAC_SECRET=
HC_AUTH_CLIENT_IP_MODE=peer
HC_AUTH_TRUSTED_PROXY_CIDRS=[]
HC_AUTH_LOGIN_FAILURE_WINDOW_SECONDS=900
HC_AUTH_LOGIN_CHALLENGE_AFTER_FAILURES=3
HC_AUTH_LOGIN_DELAY_AFTER_FAILURES=5
HC_AUTH_LOGIN_DELAY_INITIAL_SECONDS=30
HC_AUTH_LOGIN_DELAY_MAX_SECONDS=600
HC_AUTH_LOGIN_LOCK_AFTER_FAILURES=10
HC_AUTH_LOGIN_LOCK_SECONDS=3600
HC_AUTH_LOGIN_SOURCE_RATE_LIMIT=30
HC_AUTH_LOGIN_SOURCE_RATE_WINDOW_SECONDS=60
HC_AUTH_LOGIN_SUBJECT_RATE_LIMIT=20
HC_AUTH_LOGIN_SUBJECT_RATE_WINDOW_SECONDS=900
HC_AUTH_REGISTRATION_SOURCE_RATE_LIMIT=5
HC_AUTH_REGISTRATION_SOURCE_RATE_WINDOW_SECONDS=600
HC_AUTH_REGISTRATION_SUBJECT_RATE_LIMIT=3
HC_AUTH_REGISTRATION_SUBJECT_RATE_WINDOW_SECONDS=3600
HC_AUTH_GLOBAL_RATE_LIMIT=1000
HC_AUTH_GLOBAL_RATE_WINDOW_SECONDS=60
# Production and staging require HC_AUTH_CHALLENGE_PROVIDER=turnstile plus all three values.
# The secret must be loaded from the deployment secret store, never committed here.
HC_AUTH_CHALLENGE_PROVIDER=disabled
HC_AUTH_TURNSTILE_SITE_KEY=
HC_AUTH_TURNSTILE_SECRET=
HC_AUTH_TURNSTILE_EXPECTED_HOSTNAMES=[]
HC_AUTH_TURNSTILE_CONNECT_TIMEOUT_SECONDS=3
HC_AUTH_TURNSTILE_READ_TIMEOUT_SECONDS=5
# Password recovery is disabled until the SMTP and public reset-link contract is complete.
HC_AUTH_RECOVERY_ENABLED=false
HC_AUTH_RECOVERY_EMAIL_VERIFICATION_TTL_SECONDS=600
HC_AUTH_RECOVERY_TOKEN_TTL_SECONDS=900
HC_AUTH_RECOVERY_PUBLIC_BASE_URL=
HC_AUTH_RECOVERY_EMAIL_FROM=
HC_AUTH_SMTP_HOST=
HC_AUTH_SMTP_PORT=587
HC_AUTH_SMTP_USERNAME=
# Load this from a secret store outside local development.
HC_AUTH_SMTP_PASSWORD=
HC_AUTH_SMTP_STARTTLS=true
HC_AUTH_SMTP_TIMEOUT_SECONDS=10
HC_READINESS_TIMEOUT_SECONDS=3
HC_WORKFLOW_ACTIVITY_FACTORY=hc_data_platform.runtime:activity_dependencies
HC_ENFORCE_SCHEMA_MIGRATIONS=false
