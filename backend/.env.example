APP_ENV=development
DATABASE_URL=postgresql+asyncpg://platform:platform@postgres:5432/platform
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_ALGORITHM=HS256
JWT_SECRET=replace-in-local-development
JWT_ISSUER=https://identity.example.invalid/
JWT_AUDIENCE=hc-data-platform-api
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=cn-shanghai
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=platform-ingest
S3_PRESIGN_TTL_SECONDS=300
UPLOAD_AUTH_TTL_SECONDS=300
S3_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
