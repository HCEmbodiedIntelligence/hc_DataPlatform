HC_ENVIRONMENT=local
HC_RUNTIME_BACKEND=production
HC_API_HOST=0.0.0.0
HC_API_PORT=8000
HC_POSTGRES_DSN=postgresql+asyncpg://hc:hc@postgres:5432/hc_data
HC_TEMPORAL_TARGET=temporal:7233
HC_TEMPORAL_TASK_QUEUE=hc-data-pipeline
# Server-only endpoint used by API/Worker/Lance/health and all object reads/writes.
HC_OBJECT_STORE_ENDPOINT=http://minio:9000
# Browser-reachable endpoint used only to create SigV4 multipart-part PUT URLs.
HC_OBJECT_STORE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
HC_OBJECT_STORE_BUCKET=hc-data-local
HC_OBJECT_STORE_ACCESS_KEY=minio
HC_OBJECT_STORE_SECRET_KEY=minio-local-only
HC_OBJECT_STORE_REGION=us-east-1
HC_JWT_ISSUER=https://identity.example.invalid/
HC_JWT_AUDIENCE=hc-data-platform
HC_JWT_ALGORITHMS=["HS256"]
HC_JWT_JWKS_URL=
HC_JWT_SIGNING_KEY=local-development-signing-key-change-me
HC_CURSOR_SECRET=local-cursor-secret-change-me
HC_READINESS_TIMEOUT_SECONDS=3
HC_WORKFLOW_ACTIVITY_FACTORY=hc_data_platform.runtime:activity_dependencies
HC_ENFORCE_SCHEMA_MIGRATIONS=false
