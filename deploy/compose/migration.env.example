# Copy this file to a run-owned source or target env file. It is only for the
# explicit deploy/compose/compose.minio-test.yaml drill overlay; never put production OSS credentials here.
HC_COMPOSE_PROJECT_NAME=hc-migration-src-example
HC_PLATFORM_ENVIRONMENT_ID=hc-migration-src-example

# Choose a disjoint block for each project. Existing single-environment defaults
# remain 5432/19000/9001/9000/7233/8080/8000/5174/8088 when these are omitted.
HC_POSTGRES_HOST_PORT=15432
HC_MINIO_API_HOST_PORT=19010
HC_MINIO_CONSOLE_HOST_PORT=19011
HC_OBJECT_EDGE_HOST_PORT=19012
HC_TEMPORAL_HOST_PORT=17233
HC_TEMPORAL_UI_HOST_PORT=18080
HC_API_HOST_PORT=18000
HC_FRONTEND_HOST_PORT=15174
HC_GATEWAY_HOST_PORT=18088

# Source only: expose its disposable MinIO API to target containers through the
# Docker host gateway. Keep the default 127.0.0.1 outside this isolated exercise.
HC_MINIO_API_BIND_ADDRESS=127.0.0.1

# Target reuse_external example (replace SOURCE_MINIO_PORT with the source API
# port). PostgreSQL and Temporal continue to resolve only inside this project.
HC_OBJECT_STORE_ENDPOINT=http://host.docker.internal:SOURCE_MINIO_PORT
HC_OBJECT_STORE_BUCKET=hc-data-local
HC_OBJECT_STORE_ACCESS_KEY=disposable-access-key
HC_OBJECT_STORE_SECRET_KEY=disposable-secret-key

# Both projects must use the same release identity and image digests.
HC_RELEASE_ID=platform-v0.1.0-dev
HC_RELEASE_MANIFEST_DIGEST=unreleased
HC_MIGRATION_MANIFEST_DIGEST=unreleased
HC_API_IMAGE_DIGEST=unreleased
HC_WORKER_IMAGE_DIGEST=unreleased
