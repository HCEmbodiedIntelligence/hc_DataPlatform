{
  "name": "hc-data-platform-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x",
    "pnpm": "10.x"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:container": "node scripts/assert-production-env.mjs && tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "gen:api": "node scripts/generate-api-client.mjs",
    "verify:visual-baseline": "node scripts/verify-visual-baseline.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.85.5",
    "@tanstack/react-table": "8.21.3",
    "antd": "6.6.0",
    "echarts": "6.0.0",
    "hls.js": "1.7.0",
    "lucide-react": "0.542.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "7.62.0",
    "react-router-dom": "7.8.2",
    "three": "0.180.0",
    "urdf-loader": "0.12.6",
    "zod": "4.1.5",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@playwright/test": "1.55.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "@typescript-eslint/eslint-plugin": "8.41.0",
    "@typescript-eslint/parser": "8.41.0",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "4.13.0",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "jsdom": "26.1.0",
    "msw": "2.11.1",
    "openapi-typescript": "7.9.1",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  }
}
