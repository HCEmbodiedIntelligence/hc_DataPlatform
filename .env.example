# Optional object-store overrides for deployments outside compose.dev.yaml.
# Development Compose uses bundled local MinIO and ignores these cloud overrides.
# No OSS credentials or platform object-store setup are needed for local G1 uploads.
HC_OBJECT_STORE_ENDPOINT=
HC_OBJECT_STORE_PUBLIC_ENDPOINT=
HC_OBJECT_STORE_BUCKET=
HC_OBJECT_STORE_ACCESS_KEY=
HC_OBJECT_STORE_SECRET_KEY=
HC_OBJECT_STORE_REGION=

# Optional legacy processing only; compose.single-server.yaml forces false.
# Reconstructible LeRobot processing cache; original preview does not use it.
HC_LEROBOT_CACHE_MAX_BYTES=5368709120
HC_LEROBOT_CACHE_TTL_HOURS=24
