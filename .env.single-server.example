# Copy to .env.single-server and replace credentials. Keep this file during migration.
# This defaults to the existing private/local authentication profile with production images.
# Internet-facing deployment must use the production authentication/release settings in .env.example.
HC_ENVIRONMENT=local
HC_ENV_FILE=.env.single-server
HC_PUBLIC_ORIGIN=http://127.0.0.1:8088
HC_BIND_ADDRESS=127.0.0.1
HC_HTTP_PORT=8088
HC_DB_PASSWORD=replace-with-a-random-url-safe-password
HC_S3_ACCESS_KEY=hc-storage
HC_S3_SECRET_KEY=replace-with-a-random-storage-secret
HC_CURSOR_SECRET=replace-with-a-random-cursor-secret
HC_DATA_SOURCE_CREDENTIAL_KEY=replace-with-a-random-credential-key
HC_JWT_ISSUER=https://data.example.com/
HC_JWT_AUDIENCE=hc-data-platform
HC_JWT_ALGORITHMS=["HS256"]
HC_JWT_SIGNING_KEY=replace-with-a-random-signing-key
HC_POSTGRES_VOLUME=hc-data-platform-single_postgres-data
HC_MINIO_VOLUME=hc-data-platform-single_minio-data
HC_API_CPUS=2
HC_API_MEMORY=2g
HC_DB_CPUS=1
HC_DB_MEMORY=768m
HC_S3_CPUS=1
HC_S3_MEMORY=1g
HC_WEB_CPUS=0.5
HC_WEB_MEMORY=128m

HC_WORKER_CPUS=2
HC_LOCAL_SCOPE_DISCOVERY=true
HC_OUTBOX_SCOPES=[]
HC_STORAGE_INVENTORY_SCOPES=[]
HC_WORKER_MEMORY=3g
HC_TEMPORAL_CPUS=1
HC_TEMPORAL_MEMORY=1g
